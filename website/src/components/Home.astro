---
import CanvasPreview from './CanvasPreview.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import Layout from '../layouts/Layout.astro';
import { links, localePath, pageCopy, type Lang } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = pageCopy(lang);
const home = localePath(lang);
const tones = ['indigo', 'green', 'amber', 'green', 'indigo', 'amber'];
---

<Layout lang={lang} title={tr.meta.homeTitle} description={tr.meta.homeDescription} home>
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{tr.hero.eyebrow}</p>
      <h1>{tr.hero.title}</h1>
      <p class="lead">{tr.hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn--primary btn--large" href={`${home}#get-started`} data-umami-event="get-started">
          {tr.hero.primary}
          <Icon name="arrow-right" size={18} />
        </a>
        <a
          class="btn btn--secondary btn--large"
          href={links.repo}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="open-github"
        >
          <Icon name="github" size={18} />
          {tr.hero.secondary}
        </a>
      </div>
      <p class="hero-note">{tr.hero.note}</p>

      <figure class="shot">
        <img
          src={`${import.meta.env.BASE_URL}preview.png`}
          width="2560"
          height="1600"
          alt={tr.hero.imageAlt}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section" id="features">
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{tr.features.kicker}</p>
        <h2>{tr.features.title}</h2>
        <p>{tr.features.lead}</p>
      </header>

      <div class="feature-grid">
        {tr.features.cards.map((card, index) => (
          <article class={`card card--${tones[index]}`}>
            <span class="card-icon"><Icon name={card.icon as IconName} size={22} /></span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap split">
      <div class="split-copy">
        <p class="kicker">{tr.canvases.kicker}</p>
        <h2>{tr.canvases.title}</h2>
        <p class="lead-sm">{tr.canvases.lead}</p>
        <ul class="points">
          {tr.canvases.points.map((point) => (
            <li>
              <Icon name="check" size={18} />
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
      <CanvasPreview lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="band">
        <div>
          <p class="kicker">{tr.model.kicker}</p>
          <h2>{tr.model.title}</h2>
          <p class="lead-sm">{tr.model.lead}</p>
        </div>
        <div>
          <div class="chips">
            {tr.model.providers.map((provider) => <span class="chip">{provider}</span>)}
          </div>
          <p class="band-note">
            <Icon name="terminal" size={16} />
            <span>{tr.model.note}</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--code">
      <div class="split-copy">
        <p class="kicker">{tr.file.kicker}</p>
        <h2>{tr.file.title}</h2>
        <p class="lead-sm">{tr.file.lead}</p>
      </div>
      <div class="code-window" dir="ltr">
        <div class="code-bar">
          <span class="code-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="code-name">coffee-shop.flow</span>
        </div>
        <pre><code><span class="tok-comment"># Screens and flows in one plain-text file.</span>
<span class="tok-key">screen</span> shop <span class="tok-str">"Coffee shop"</span> device=phone
  <span class="tok-key">box</span> <span class="tok-prop">class</span>=<span class="tok-str">"gap-6 bg-white px-6 pt-16"</span>
    <span class="tok-key">icon</span> coffee <span class="tok-prop">class</span>=<span class="tok-str">"size-14 text-amber-600"</span>
    <span class="tok-key">text</span> <span class="tok-str">"Welcome back"</span> <span class="tok-prop">class</span>=<span class="tok-str">"text-3xl font-bold"</span>
  <span class="tok-key">end</span>
<span class="tok-key">end</span>

<span class="tok-key">flow</span> order <span class="tok-str">"Order handling"</span>
  <span class="tok-key">node</span> start <span class="tok-str">"Order placed"</span> kind=start
  <span class="tok-key">node</span> check <span class="tok-str">"Check stock"</span> kind=decision note=<span class="tok-str">"Reserve every item"</span>
  <span class="tok-key">node</span> pay <span class="tok-str">"Charge card"</span> status=doing
  start -&gt; check
  check -&gt; pay <span class="tok-str">"in stock"</span>
<span class="tok-key">end</span></code></pre>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="privacy">
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{tr.privacy.kicker}</p>
        <h2>{tr.privacy.title}</h2>
        <p>{tr.privacy.lead}</p>
      </header>
      <div class="privacy-cards">
        {tr.privacy.cards.map((card) => (
          <article class="card">
            <span class="card-icon"><Icon name={card.icon as IconName} size={22} /></span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
      <p class="privacy-link">
        <a class="text-link" href={localePath(lang, 'privacy/')}>
          {tr.privacy.link}
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <section class="section" id="get-started">
    <div class="wrap">
      <div class="split split--start">
        <div class="split-copy">
          <p class="kicker">{tr.start.kicker}</p>
          <h2>{tr.start.title}</h2>
          <p class="lead-sm">{tr.start.lead}</p>
          <ul class="requirements">
            {tr.start.requirements.map((requirement) => (
              <li>
                <Icon name="check" size={18} />
                <span>{requirement}</span>
              </li>
            ))}
          </ul>
          <div class="start-actions">
            <a
              class="btn btn--secondary"
              href={links.readme}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="open-readme"
            >
              {tr.start.primary}
              <Icon name="arrow-up-right" size={16} />
            </a>
            <a
              class="btn btn--secondary"
              href={links.examples}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="open-examples"
            >
              {tr.start.secondary}
            </a>
          </div>
        </div>

        <div>
          <div class="terminal-card" dir="ltr">
            <div class="terminal-bar">
              <span>{tr.start.terminal}</span>
              <button
                class="copy-btn"
                type="button"
                data-copy={tr.start.commands.join('\n')}
                data-label-copy={tr.actions.copy}
                data-label-copied={tr.actions.copied}
                aria-label={tr.actions.copy}
                data-umami-event="copy-command"
              >
                <Icon name="copy" size={13} />
                <span data-copy-label>{tr.actions.copy}</span>
              </button>
            </div>
            <div class="terminal-body">
              {tr.start.commands.map((command, index) => (
                <span class="terminal-line">
                  <span class="terminal-prompt" aria-hidden="true">{index === 0 ? '$' : ' '}</span>{command}
                </span>
              ))}
            </div>
          </div>
          <p class="start-note">{tr.start.note}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq">
      <h2>{tr.faq.title}</h2>
      <div class="faq-list">
        {tr.faq.items.map((item) => (
          <details>
            <summary>
              {item.q}
              <span class="faq-plus" aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
