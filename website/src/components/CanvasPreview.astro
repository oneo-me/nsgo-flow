---
import { pageCopy, type Lang } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = pageCopy(lang).canvases.preview;
---

<figure class="canvas-figure">
  <svg class="canvas-svg" viewBox="0 0 620 460" role="img" aria-label={pageCopy(lang).canvases.title}>
    <defs>
      <pattern id="canvas-dots" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" class="canvas-dot" />
      </pattern>
      <marker
        id="flow-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrow" />
      </marker>
    </defs>

    <rect x="1" y="1" width="618" height="458" rx="24" class="canvas-frame" />
    <rect x="1" y="1" width="618" height="458" rx="24" fill="url(#canvas-dots)" />

    <!-- Canvas labels -->
    <g>
      <rect x="46" y="34" width="76" height="26" rx="13" class="canvas-tag-bg" />
      <text x="84" y="51" text-anchor="middle" class="canvas-tag-text">{tr.design}</text>
    </g>
    <g>
      <rect x="300" y="34" width="56" height="26" rx="13" class="canvas-tag-bg" />
      <text x="328" y="51" text-anchor="middle" class="canvas-tag-text">{tr.flow}</text>
    </g>

    <!-- A phone design -->
    <g>
      <rect x="46" y="80" width="158" height="350" rx="26" class="phone-body" />
      <rect x="54" y="88" width="142" height="334" rx="20" class="phone-screen" />
      <rect x="104" y="96" width="42" height="6" rx="3" class="phone-notch" />

      <circle cx="125" cy="138" r="21" class="phone-badge" />
      <g class="phone-badge-icon">
        <path d="M118 134h12v7a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5z" />
        <path d="M130 136h2a3 3 0 0 1 0 6h-2" />
        <path d="M121 129v2" />
        <path d="M125 128v3" />
        <path d="M129 129v2" />
      </g>

      <text x="125" y="188" text-anchor="middle" class="phone-title">{tr.screen}</text>
      <text x="125" y="205" text-anchor="middle" class="phone-lead">{tr.welcome}</text>

      <rect x="68" y="222" width="114" height="30" rx="9" class="phone-field" />
      <text x="79" y="241" class="phone-field-text">{tr.email}</text>
      <rect x="68" y="258" width="114" height="30" rx="9" class="phone-field" />
      <text x="79" y="277" class="phone-field-text">••••••••</text>

      <rect x="68" y="300" width="114" height="32" rx="9" class="phone-button" />
      <text x="125" y="321" text-anchor="middle" class="phone-button-text">{tr.button}</text>

      <line x1="68" y1="350" x2="182" y2="350" class="phone-divider" />
      <rect x="68" y="362" width="54" height="26" rx="7" class="phone-field" />
      <text x="95" y="379" text-anchor="middle" class="phone-field-text">Apple</text>
      <rect x="128" y="362" width="54" height="26" rx="7" class="phone-field" />
      <text x="155" y="379" text-anchor="middle" class="phone-field-text">Google</text>
    </g>

    <!-- A flow chart -->
    <path d="M415 128v34" class="edge" marker-end="url(#flow-arrow)" />
    <path d="M415 234v34" class="edge" marker-end="url(#flow-arrow)" />

    <g>
      <rect x="420" y="146" width="48" height="17" rx="8.5" class="edge-label-bg" />
      <text x="444" y="158" text-anchor="middle" class="edge-label">{tr.inStock}</text>
    </g>

    <g class="node">
      <rect x="300" y="64" width="230" height="64" rx="14" class="node-body" />
      <rect x="314" y="80" width="32" height="32" rx="9" class="node-icon--green" />
      <path d="M324 89v14l12-7z" class="node-glyph--green" />
      <text x="358" y="92" class="node-title">{tr.placed}</text>
      <text x="358" y="110" class="node-note">start</text>
    </g>

    <g class="node">
      <rect x="300" y="170" width="230" height="64" rx="14" class="node-body" />
      <rect x="314" y="186" width="32" height="32" rx="9" class="node-icon--amber" />
      <circle cx="329" cy="201" r="6" class="node-glyph--amber" />
      <path d="m334 206 4 4" class="node-glyph--amber" />
      <text x="358" y="198" class="node-title">{tr.check}</text>
      <text x="358" y="216" class="node-note">{tr.reserve}</text>
    </g>

    <g class="node node--selected">
      <rect x="300" y="276" width="230" height="64" rx="14" class="node-body" />
      <rect x="314" y="292" width="32" height="32" rx="9" class="node-icon--indigo" />
      <rect x="322" y="301" width="16" height="12" rx="2.5" class="node-glyph--indigo" />
      <path d="M322 306h16" class="node-glyph--indigo" />
      <text x="358" y="304" class="node-title">{tr.charge}</text>
      <text x="358" y="322" class="node-note">{tr.doing}</text>
    </g>
  </svg>
</figure>
