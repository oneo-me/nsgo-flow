title "Coffee shop"

screen signin "Sign in"
  box class="flex-1 gap-6 bg-white px-6 pt-16 pb-10"
    box class="size-14 items-center justify-center rounded-2xl bg-amber-600 shadow-lg"
      icon coffee class="size-7 text-white"
    end
    box class="gap-2"
      text "Welcome back" class="text-3xl font-bold text-zinc-900"
      text "Sign in to order ahead and collect points." class="text-base text-zinc-500"
    end
    box class="gap-3"
      box class="h-12 flex-row items-center gap-3 rounded-xl border border-zinc-200 bg-zinc-50 px-4"
        icon mail class="size-4 text-zinc-400"
        text "you@example.com" class="text-zinc-900"
      end
      box class="h-12 flex-row items-center gap-3 rounded-xl border border-zinc-200 bg-zinc-50 px-4"
        icon lock class="size-4 text-zinc-400"
        text "••••••••" class="flex-1 text-zinc-900"
        icon eye-off class="size-4 text-zinc-400"
      end
      box class="flex-row items-center justify-between"
        box class="flex-row items-center gap-2"
          box class="size-5 items-center justify-center rounded-md bg-amber-600"
            icon check class="size-3.5 text-white"
          end
          text "Remember me" class="text-sm text-zinc-700"
        end
        text "Forgot password?" class="text-sm font-medium text-amber-700"
      end
    end
    box class="h-12 flex-row items-center justify-center gap-2 rounded-xl bg-amber-600 shadow-md"
      text "Sign in" class="text-base font-semibold text-white"
      icon arrow-right class="size-4 text-white"
    end
    box class="flex-row items-center gap-3"
      box class="h-px flex-1 bg-zinc-200"
      end
      text "or" class="text-sm text-zinc-400"
      box class="h-px flex-1 bg-zinc-200"
      end
    end
    box class="flex-row gap-3"
      box class="h-12 flex-1 items-center justify-center rounded-xl border border-zinc-200"
        text "Apple" class="font-medium text-zinc-900"
      end
      box class="h-12 flex-1 items-center justify-center rounded-xl border border-zinc-200"
        text "Google" class="font-medium text-zinc-900"
      end
    end
    box class="flex-1"
    end
    box class="flex-row items-center gap-3 rounded-2xl bg-amber-50 p-4"
      icon gift class="size-5 text-amber-700"
      box class="flex-1 gap-0.5"
        text "New here?" class="font-semibold text-amber-900"
        text "Your first drink is on us." class="text-sm text-amber-800"
      end
    end
  end

  flow login "Signing in"
    node tap "Tap Sign in" kind=start
    node check "Check password" kind=decision note="Lock after 5 tries"
    node home "Show the menu" kind=end
    node error "Show the error"
    tap -> check
    check -> home "valid"
    check -> error "invalid"
    error ..> tap "try again"

  flow reset "Resetting the password"
    direction right
    node forgot "Tap Forgot password" kind=start
    node mail "Send a reset link" kind=data
    node done "Set a new password" kind=end
    forgot -> mail -> done

screen menu "Menu"
  box class="flex-1 bg-zinc-50"
    box class="gap-4 bg-white px-5 pt-14 pb-4"
      box class="flex-row items-center justify-between"
        box class="gap-0.5"
          text "Good morning" class="text-sm text-zinc-500"
          text "What's your brew?" class="text-2xl font-bold text-zinc-900"
        end
        box class="size-11 items-center justify-center rounded-full bg-zinc-100"
          icon shopping-cart class="size-5 text-zinc-800"
          box class="absolute -top-0.5 -right-0.5 size-5 items-center justify-center rounded-full bg-amber-600"
            text "2" class="text-xs font-bold text-white"
          end
        end
      end
      box class="h-11 flex-row items-center gap-2 rounded-xl bg-zinc-100 px-4"
        icon search class="size-4 text-zinc-400"
        text "Search drinks" class="text-zinc-400"
      end
      box class="flex-row gap-2"
        box class="rounded-full bg-zinc-900 px-4 py-2"
          text "Coffee" class="text-sm font-medium text-white"
        end
        box class="rounded-full bg-zinc-100 px-4 py-2"
          text "Tea" class="text-sm font-medium text-zinc-700"
        end
        box class="rounded-full bg-zinc-100 px-4 py-2"
          text "Snacks" class="text-sm font-medium text-zinc-700"
        end
      end
    end
    box class="flex-1 gap-4 p-5"
      box class="gap-1 overflow-hidden rounded-3xl bg-linear-to-br from-amber-500 to-orange-600 p-5 shadow-lg"
        text "Flat white" class="text-xl font-bold text-white"
        text "Double ristretto with silky milk" class="text-sm text-white/80"
        box class="mt-3 flex-row items-center justify-between"
          text "$4.50" class="text-2xl font-bold text-white"
          box class="size-10 items-center justify-center rounded-full bg-white"
            icon plus class="size-5 text-orange-600"
          end
        end
      end
      text "Today" class="text-xs font-semibold uppercase tracking-wider text-zinc-500"
      box class="rounded-2xl bg-white px-4 shadow-sm"
        box class="flex-row items-center gap-3 border-b border-zinc-100 py-3"
          box class="size-10 items-center justify-center rounded-xl bg-amber-100"
            icon coffee class="size-5 text-amber-700"
          end
          box class="flex-1"
            text "Latte" class="font-medium text-zinc-900"
            text "Espresso and steamed milk" class="text-sm text-zinc-500"
          end
          text "$4.20" class="font-semibold text-zinc-900"
        end
        box class="flex-row items-center gap-3 py-3"
          box class="size-10 items-center justify-center rounded-xl bg-sky-100"
            icon zap class="size-5 text-sky-700"
          end
          box class="flex-1"
            text "Cold brew" class="font-medium text-zinc-900"
            text "Steeped for 18 hours" class="text-sm text-zinc-500"
          end
          text "$4.00" class="font-semibold text-zinc-900"
        end
      end
    end
    box class="flex-row border-t border-zinc-200 bg-white px-2 pt-2 pb-7"
      box class="flex-1 items-center gap-1"
        icon house class="size-6 text-amber-600"
        text "Home" class="text-[10px] font-medium text-amber-600"
      end
      box class="flex-1 items-center gap-1"
        icon search class="size-6 text-zinc-400"
        text "Search" class="text-[10px] font-medium text-zinc-400"
      end
      box class="flex-1 items-center gap-1"
        icon package class="size-6 text-zinc-400"
        text "Orders" class="text-[10px] font-medium text-zinc-400"
      end
      box class="flex-1 items-center gap-1"
        icon user class="size-6 text-zinc-400"
        text "Profile" class="text-[10px] font-medium text-zinc-400"
      end
    end
  end

  flow order "Ordering a drink"
    node pick "Pick a drink" kind=start
    node size "Choose the size" note="Small, medium or large"
    node cart "Add to cart" kind=data
    node pay "Pay" kind=decision
    node ready "Collect at the counter" kind=end status=todo
    pick -> size -> cart -> pay
    pay -> ready "paid"
    pay ..> cart "declined"

screen admin "Dashboard" device=desktop
  box class="flex-1 flex-row bg-zinc-50"
    box class="w-56 gap-1 border-r border-zinc-200 bg-white p-4"
      box class="mb-4 flex-row items-center gap-2 px-2"
        box class="size-8 items-center justify-center rounded-lg bg-amber-600"
          icon coffee class="size-4 text-white"
        end
        text "Bean & Co" class="text-lg font-bold text-zinc-900"
      end
      box class="h-9 flex-row items-center gap-3 rounded-lg bg-amber-50 px-3"
        icon layout-dashboard class="size-4 text-amber-700"
        text "Overview" class="flex-1 text-sm font-medium text-amber-900"
      end
      box class="h-9 flex-row items-center gap-3 rounded-lg px-3"
        icon package class="size-4 text-zinc-500"
        text "Orders" class="flex-1 text-sm text-zinc-700"
        box class="rounded-full bg-zinc-100 px-2 py-0.5"
          text "12" class="text-xs font-medium text-zinc-600"
        end
      end
      box class="h-9 flex-row items-center gap-3 rounded-lg px-3"
        icon users class="size-4 text-zinc-500"
        text "Customers" class="flex-1 text-sm text-zinc-700"
      end
      box class="h-9 flex-row items-center gap-3 rounded-lg px-3"
        icon coffee class="size-4 text-zinc-500"
        text "Menu" class="flex-1 text-sm text-zinc-700"
      end
      box class="flex-1"
      end
      box class="h-9 flex-row items-center gap-3 rounded-lg px-3"
        icon settings class="size-4 text-zinc-500"
        text "Settings" class="flex-1 text-sm text-zinc-700"
      end
    end
    box class="flex-1 gap-6 p-8"
      box class="flex-row items-center justify-between"
        box class="gap-1"
          text "Overview" class="text-2xl font-bold text-zinc-900"
          text "Store · Downtown" class="text-sm text-zinc-500"
        end
        box class="h-9 flex-row items-center gap-2 rounded-lg bg-zinc-900 px-4"
          icon download class="size-4 text-white"
          text "Export" class="text-sm font-medium text-white"
        end
      end
      box class="flex-row gap-4"
        box class="flex-1 gap-2 rounded-2xl border border-zinc-200 bg-white p-5"
          box class="flex-row items-center justify-between"
            text "Revenue" class="text-sm text-zinc-500"
            icon wallet class="size-4 text-zinc-400"
          end
          text "$12,480" class="text-2xl font-bold text-zinc-900"
          box class="flex-row items-center gap-1"
            icon trending-up class="size-3.5 text-emerald-600"
            text "+8.2% this week" class="text-sm text-emerald-600"
          end
        end
        box class="flex-1 gap-2 rounded-2xl border border-zinc-200 bg-white p-5"
          box class="flex-row items-center justify-between"
            text "Orders" class="text-sm text-zinc-500"
            icon package class="size-4 text-zinc-400"
          end
          text "1,204" class="text-2xl font-bold text-zinc-900"
          box class="flex-row items-center gap-1"
            icon trending-up class="size-3.5 text-emerald-600"
            text "+3.1% this week" class="text-sm text-emerald-600"
          end
        end
        box class="flex-1 gap-2 rounded-2xl border border-zinc-200 bg-white p-5"
          box class="flex-row items-center justify-between"
            text "Wait time" class="text-sm text-zinc-500"
            icon clock class="size-4 text-zinc-400"
          end
          text "4m 12s" class="text-2xl font-bold text-zinc-900"
          box class="flex-row items-center gap-1"
            icon trending-down class="size-3.5 text-rose-600"
            text "+40s this week" class="text-sm text-rose-600"
          end
        end
      end
      box class="flex-1 flex-row gap-4"
        box class="flex-1 gap-4 rounded-2xl border border-zinc-200 bg-white p-5"
          text "Orders this week" class="font-semibold text-zinc-900"
          svg "<svg viewBox='0 0 600 180'><defs><linearGradient id='fill' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#f59e0b' stop-opacity='0.35'/><stop offset='1' stop-color='#f59e0b' stop-opacity='0'/></linearGradient></defs><path d='M0 140 L100 100 L200 118 L300 76 L400 44 L500 58 L600 16 L600 180 L0 180 Z' fill='url(#fill)'/><path d='M0 140 L100 100 L200 118 L300 76 L400 44 L500 58 L600 16' fill='none' stroke='#d97706' stroke-width='3' stroke-linejoin='round'/></svg>" class="h-44 w-full"
          box class="flex-row justify-between"
            text "Mon" class="text-xs text-zinc-400"
            text "Tue" class="text-xs text-zinc-400"
            text "Wed" class="text-xs text-zinc-400"
            text "Thu" class="text-xs text-zinc-400"
            text "Fri" class="text-xs text-zinc-400"
            text "Sat" class="text-xs text-zinc-400"
            text "Sun" class="text-xs text-zinc-400"
          end
        end
        box class="flex-1 gap-5 rounded-2xl border border-zinc-200 bg-white p-5"
          text "Goals" class="font-semibold text-zinc-900"
          box class="gap-2"
            box class="flex-row justify-between"
              text "Daily sales" class="text-sm text-zinc-700"
              text "72%" class="text-sm font-medium text-zinc-900"
            end
            box class="h-2 rounded-full bg-zinc-100"
              box class="h-2 w-[72%] rounded-full bg-amber-500"
              end
            end
          end
          box class="gap-2"
            box class="flex-row justify-between"
              text "Loyalty sign-ups" class="text-sm text-zinc-700"
              text "45%" class="text-sm font-medium text-zinc-900"
            end
            box class="h-2 rounded-full bg-zinc-100"
              box class="h-2 w-[45%] rounded-full bg-emerald-500"
              end
            end
          end
          box class="gap-2"
            box class="flex-row justify-between"
              text "Queue under 5 minutes" class="text-sm text-zinc-700"
              text "88%" class="text-sm font-medium text-zinc-900"
            end
            box class="h-2 rounded-full bg-zinc-100"
              box class="h-2 w-[88%] rounded-full bg-sky-500"
              end
            end
          end
        end
      end
    end
  end

  flow refund "Refunding an order"
    node ask "Customer asks" kind=start
    node check "Within 24 hours?" kind=decision
    node refund "Refund to card" kind=end
    node credit "Offer store credit" kind=end
    ask -> check
    check -> refund "yes"
    check -> credit "no"
